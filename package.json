{
  "name": "ins",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:lan": "astro dev --host 0.0.0.0",
    "build": "npm run cf:redirects && npm run blog:fix-media && npm run wp:resolve-images && astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "preview:lan": "wrangler dev --config dist/server/wrangler.json --ip 0.0.0.0",
    "astro": "astro",
    "cf:redirects": "tsx scripts/generate-cloudflare-redirects.ts",
    "cf:redirects:check": "tsx scripts/generate-cloudflare-redirects.ts --check",
    "cf:redirects:verify": "tsx scripts/verify-redirects.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:legacy-redirects": "wrangler deploy --config workers/legacy-redirects/wrangler.jsonc",
    "wp:import": "tsx scripts/parse-wordpress-xml.ts",
    "wp:cache-images": "node scripts/cache-post-images.cjs",
    "wp:resolve-images": "node scripts/resolve-local-images.cjs",
    "wp:sync": "npm run wp:import && npm run wp:resolve-images",
    "wp:audit:thumbs": "node scripts/export-thumbnail-audit.cjs",
    "blog:migrate": "node scripts/migrate-wp-md-to-content.cjs",
    "blog:validate": "node scripts/validate-blog-content.mjs",
    "blog:aio": "tsx scripts/apply-blog-aio.ts",
    "blog:aio:hrefs": "tsx scripts/rewrite-case-study-hrefs.ts",
    "blog:aio:audit": "tsx scripts/audit-blog-aio.ts",
    "blog:aio:loop": "tsx scripts/verify-blog-aio-loop.ts",
    "blog:aio:test": "tsx scripts/test-blog-aio.ts",
    "blog:fix-media": "node scripts/fix-blog-media-paths.mjs",
    "gsc": "tsx scripts/gsc/sync.ts",
    "gsc:sync": "npm run build && npm run gsc -- sync",
    "sachi:sync": "npm run gsc:sync"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/postcss": "^4.2.4",
    "astro": "^6.0.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.8.0",
    "tsx": "^4.22.3",
    "wrangler": "^4.136.2"
  }
}
