{
  // Cloudflare Workers configuration for the INS site (Astro SSR + static assets).
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ins",
  "compatibility_date": "2026-04-15",
  // `nodejs_compat` is required by `Buffer` usage in the GitHub publisher and by Astro internals.
  "compatibility_flags": ["nodejs_compat"],
  // Production (`npx wrangler deploy`) runs this before upload. Workers Builds' Build
  // command should stay empty so this is not executed twice. `npx wrangler preview`
  // is only for non-production branches and does not publish insbs.net.
  "build": { "command": "node scripts/cf-workers-build.mjs" },
  // Package export (no file extension) so Vite can resolve it during `astro build`. After the
  // custom build, wrangler looks for `<repo>/@astrojs/cloudflare/entrypoints/server.js`.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Prerendered pages are directories containing `index.html`; Astro emits trailing-slash URLs.
    "html_handling": "auto-trailing-slash",
    // Unknown paths fall through to the Worker so Astro can render its own 404 page.
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  // Serve on *.workers.dev. Do NOT put `insbs.net` here as custom_domain.
  // Wrangler attach fails until the zone is Active in THIS Workers account
  // (workers.api.error.zone_not_found). A just-added zone is Pending until
  // nameservers change, so a production deploy with custom_domain breaks
  // Workers Builds (2026-09-25, build 83e88a72). Bind the hostname in the
  // dashboard after the zone exists: Workers → ins → Settings → Domains &
  // Routes → Add insbs.net. Map: cloudflare/domains.json.
  "workers_dev": true,
  // Plain-text dashboard variables are deleted on `wrangler deploy` unless this is true.
  // BLOG_PUBLISH_GITHUB_TOKEN is a runtime Secret (Settings → Runtime → ランタイム変数とシークレット).
  // A Build variable is not visible when a post is published.
  "keep_vars": true,
  "vars": {
    "DECAP_SITE_URL": "https://insbs.net",
    "BLOG_PUBLISH_GITHUB_REPO": "fins250903-arch/INS",
    "BLOG_PUBLISH_GITHUB_BRANCH": "main"
  },
  // Required by `npx wrangler preview` (Workers Builds preview command, open beta).
  // Without this block the command exits before the custom build. Previews do not
  // inherit `vars`. Assets, compatibility, and `main` stay at the top level.
  "previews": {
    "vars": {
      "DECAP_SITE_URL": "https://insbs.net",
      "BLOG_PUBLISH_GITHUB_REPO": "fins250903-arch/INS",
      "BLOG_PUBLISH_GITHUB_BRANCH": "main"
    }
  }
}
