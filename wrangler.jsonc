{
  // Cloudflare Workers configuration for the INS site (Astro SSR + static assets).
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ins",
  "compatibility_date": "2026-04-15",
  // `nodejs_compat` is required by `Buffer` usage in the GitHub publisher and by Astro internals.
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "binding": "ASSETS",
    // Prerendered pages are directories containing `index.html`; Astro emits trailing-slash URLs.
    "html_handling": "auto-trailing-slash",
    // Unknown paths fall through to the Worker so Astro can render its own 404 page.
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  // Session storage for `Astro.session`. The namespace is provisioned automatically on first deploy.
  "kv_namespaces": [{ "binding": "SESSION" }],
  // Production hostnames. Cloudflare creates/updates the DNS records for custom domains on deploy,
  // so the zone `insbs.net` must already exist in the same Cloudflare account.
  "routes": [{ "pattern": "insbs.net", "custom_domain": true }],
  "vars": {
    "DECAP_SITE_URL": "https://insbs.net",
    "BLOG_PUBLISH_GITHUB_REPO": "fins250903-arch/INS",
    "BLOG_PUBLISH_GITHUB_BRANCH": "main"
  }
}
