---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LandingPage from '../components/LandingPage.astro';
import { osakaServiceAreas } from '../data/service-areas/osaka';
import { buildRegionFaqs } from '../data/lp-faqs';
import { getCaseStudiesForSlug } from '../data/lp-region-case-studies';
import { buildLpJsonLd } from '../lib/lp-json-ld';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import { prepareRegionLpContent } from '../lib/blog-lp-feed';

const layoutTitle = '大阪の車内嘔吐・ゲロ掃除｜出張車内清掃 即日｜INS';
const layoutDescription =
	'車内で嘔吐・ゲロした直後でも駐車場へ即日出張。消臭スプレーは使わず4日以内に温水吸引。大阪府全域・365日24時間・立会不要。';
/** 大阪 LP の正規 URL（トップ `/` はここへ集約） */
const osakaCanonicalPath = '/osaka/';

const osakaCaseStudies = getCaseStudiesForSlug('index');
const osakaLpBlog = await prepareRegionLpContent({
	regionSlug: 'osaka',
	regionName: '大阪',
	regionFull: '大阪府',
	caseStudies: osakaCaseStudies
});
const mergedOsakaCaseStudies = osakaLpBlog.caseStudies ?? osakaCaseStudies;

const jsonLd = buildLpJsonLd({
	path: osakaCanonicalPath,
	regionFull: '大阪府',
	regionName: '大阪',
	description: layoutDescription,
	pageTitle: layoutTitle,
	faqs: buildRegionFaqs('大阪', '大阪府', 'osaka'),
	localBusinessDescription: mergedOsakaCaseStudies?.lead,
	caseStudies: mergedOsakaCaseStudies,
	regionSlug: 'osaka'
});
---

<Layout
	title={layoutTitle}
	description={layoutDescription}
	canonical={osakaCanonicalPath}
	jsonLd={jsonLd}
>
	<Header />
	<main>
		<LandingPage
			regionName="大阪"
			regionFull="大阪府"
			showAreaList={true}
			serviceAreas={osakaServiceAreas}
			caseStudies={mergedOsakaCaseStudies}
			regionSlug="osaka"
			blogFeed={osakaLpBlog.feed}
		/>
	</main>
	<Footer regionFull="大阪府" regionName="大阪" />
	<FloatingCTA />
</Layout>
