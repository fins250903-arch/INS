---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import ContactInquiryForm from '../components/ContactInquiryForm.astro';
import { LINE_OFFICIAL_URL, TEL_DISPLAY, TEL_HREF } from '../data/site';
import { buildPageJsonLd } from '../lib/json-ld-site';

const contactJsonLd = buildPageJsonLd({
  path: '/contact/',
  title: 'お問い合わせ｜アイエヌエス車内清掃',
  description: '365日24時間受付。フォーム・お電話・LINEでお問い合わせください。',
  pageType: 'ContactPage'
});
---

<Layout
  title="お問い合わせ｜アイエヌエス車内清掃"
  description="365日24時間受付。フォーム・お電話・LINEでお問い合わせください。"
  canonical="/contact/"
  jsonLd={contactJsonLd}
>
  <Header />
  <main class="bg-white">
    <section class="max-w-3xl mx-auto px-6 pb-24 pt-12 md:pb-12">
      <h1 class="text-3xl font-bold">お問い合わせ</h1>
      <p class="mt-4 text-sm text-gray-600 leading-relaxed">
        365日24時間受付中です。ご相談はこのフォームから、お急ぎの方はお電話、写真を送りたい方はLINEをご利用ください。
      </p>
      <div class="mt-6 space-y-4">
        <a href={TEL_HREF} class="block rounded-xl border border-gray-200 p-4 text-lg font-bold hover:bg-gray-50 transition-colors">
          TEL: {TEL_DISPLAY}
        </a>
        <ContactInquiryForm />
        <a
          href={LINE_OFFICIAL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-xl bg-[#06C755] p-4 text-center text-white font-bold hover:opacity-90 transition-opacity"
        >
          LINE公式アカウント
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingCTA />
</Layout>
