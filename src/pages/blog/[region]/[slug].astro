---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FloatingCTA from '../../../components/FloatingCTA.astro';
import BlogCta from '../../../components/BlogCta.astro';
import BlogAioRelated from '../../../components/BlogAioRelated.astro';
import { buildBlogPostJsonLd } from '../../../lib/blog-json-ld';
import {
  getBlogSlug,
  getPublishedBlogPosts,
  resolveBlogImage,
  formatBlogDate,
  getAreaLabel
} from '../../../lib/blog-content';
import { resolveBlogSeoMeta } from '../../../lib/blog-seo';
import { collectLpHeadingLinks, collectRelatedBlogLinks, getBlogTopic, replaceRegionPlaceholder } from '../../../lib/blog-aio';
import { resolveStoreLpPath } from '../../../data/region-lp-links';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => {
    const slug = getBlogSlug(post);
    return {
      params: { region: post.data.region, slug },
      props: { post }
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = getBlogSlug(post);
const pagePath = `/blog/${post.data.region}/${slug}/`;
const headerImage = resolveBlogImage(post.data.thumbnail);
const seo = resolveBlogSeoMeta(post, pagePath);
const allPosts = await getPublishedBlogPosts();
const topic = getBlogTopic(slug, post.data.title, post.data.categories);
const answer = replaceRegionPlaceholder(topic.answer, post.data.regionFull);
const related = collectRelatedBlogLinks({ current: post, allPosts, limit: 5 });
const lpLinks = collectLpHeadingLinks({
  slug,
  title: post.data.title,
  categories: post.data.categories,
  regionSlug: post.data.region,
  regionFull: post.data.regionFull
});
const storePath = resolveStoreLpPath(post.data.region) || resolveStoreLpPath(post.data.regionFull) || '/osaka/';

const blogJsonLd = buildBlogPostJsonLd({
  path: pagePath,
  title: post.data.title,
  description: seo.description,
  datePublished: post.data.date.toISOString(),
  imageUrl: seo.ogImage,
  keywords: seo.keywords,
  regionFull: post.data.regionFull,
  answer,
  related: [...lpLinks, ...related].map((item) => ({ href: item.href, name: item.label })),
  lpUrl: storePath,
  faqs: [
    { q: `${topic.label}はどうすればいいですか？`, a: answer },
    {
      q: `${post.data.regionFull}で出張車内清掃は依頼できますか？`,
      a: `${post.data.regionFull}は駐車場完結の出張車内清掃に対応しています。料金・応急処置・保険の目安は地区ページで確認できます。`
    }
  ]
});
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  jsonLd={blogJsonLd}
  noindex={seo.noindex}
  keywords={seo.keywords}
  ogImage={seo.ogImage}
  ogType={seo.ogType}
>
  <Header />
  <main class="bg-white">
    <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-12">
      <nav class="text-sm text-gray-500">
        <a href="/blog/" class="underline hover:text-primary">ブログ一覧</a>
        <span class="mx-2">/</span>
        <a href={`/blog/region/${post.data.region}/`} class="underline hover:text-primary">
          {post.data.regionFull}
        </a>
      </nav>

      <p class="mt-4 text-xs text-gray-500">{formatBlogDate(post.data.date)}</p>
      <p class="mt-1 text-xs font-medium text-primary">{getAreaLabel(post)}</p>
      <h1 class="mt-2 text-2xl font-bold leading-snug sm:text-3xl">{post.data.title}</h1>

      {post.data.categories.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.categories.map((cat) => (
            <a
              href={`/blog/category/${encodeURIComponent(cat)}/`}
              class="rounded-full bg-gray-100 px-2.5 py-1 text-xs text-gray-600 hover:bg-gray-200"
            >
              {cat}
            </a>
          ))}
        </div>
      )}

      {headerImage && (
        <div class="mt-8 mb-8">
          <img
            src={headerImage}
            alt={post.data.title}
            class="w-full max-w-3xl rounded-xl object-cover shadow-md"
          />
        </div>
      )}

      {
        post.data.images && post.data.images.length > 0 && (
          <div class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
            {post.data.images.map((image) => (
              <img
                src={resolveBlogImage(image)}
                alt=""
                class="aspect-square w-full rounded-lg object-cover"
                loading="lazy"
              />
            ))}
          </div>
        )
      }

      <div class="prose mt-8 max-w-none wp-content aio-article-body">
        <Content />
      </div>

      <BlogAioRelated post={post} allPosts={allPosts} />
    </article>

    <BlogCta regionFull={post.data.regionFull} regionSlug={post.data.region} />
  </main>
  <Footer regionFull={post.data.regionFull} />
  <FloatingCTA />
</Layout>

<style>
  .aio-article-body :global(h2:first-of-type) {
    border-left: 4px solid #ba6022;
    padding-left: 0.75rem;
    background: #fff7ed;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-radius: 0 0.75rem 0.75rem 0;
  }
</style>
