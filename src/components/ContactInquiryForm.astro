---
import {
  FORM_SUBMIT_ENDPOINT,
  INQUIRY_NEXT_URL,
  INQUIRY_SUBJECT
} from '../lib/contact-form';
---

<form
  id="contact-form"
  class="mt-6 rounded-xl border border-gray-200 bg-white p-4 sm:p-6"
  action={FORM_SUBMIT_ENDPOINT}
  method="POST"
  accept-charset="UTF-8"
  aria-describedby="contact-form-note"
>
  <h2 class="text-xl font-bold text-gray-900">ご相談フォーム</h2>
  <p id="contact-form-note" class="mt-2 text-sm leading-relaxed text-gray-600">
    お名前、電話番号、郵便番号、相談内容を入力して送信してください。お名前・電話番号・郵便番号・相談内容は、ご相談への回答のために利用します。
  </p>

  <div id="contact-status" class="sr-only" aria-live="polite"></div>

  <div id="contact-success" class="mt-6 rounded-xl border border-primary/40 bg-primary/10 p-4" hidden>
    <h2 tabindex="-1" class="text-lg font-bold text-gray-900 outline-none">送信を受け付けました</h2>
    <p class="mt-2 text-sm leading-relaxed text-gray-700">
      担当者よりご連絡いたします。しばらくお待ちください。お急ぎの場合は、このページのお電話またはLINEをご利用ください。
    </p>
  </div>

  <div id="contact-fields">
    <input type="hidden" name="_subject" value={INQUIRY_SUBJECT} />
    <input type="hidden" name="_next" value={INQUIRY_NEXT_URL} />
    <div aria-hidden="true" style="display:none">
      <label for="contact-honey">Leave blank</label>
      <input id="contact-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" value="" />
    </div>

    <div class="mt-5">
      <label for="contact-name" class="block text-sm font-bold text-gray-900">お名前</label>
      <input
        id="contact-name"
        name="お名前"
        type="text"
        required
        maxlength="80"
        autocomplete="name"
        placeholder="山田 太郎"
        class="mt-1 w-full min-h-12 rounded-lg border border-gray-300 px-3 py-3 text-[16px] text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
      />
      <p id="contact-name-error" class="mt-1 text-sm font-bold text-cta-red" role="alert"></p>
    </div>

    <div class="mt-4">
      <label for="contact-phone" class="block text-sm font-bold text-gray-900">電話番号</label>
      <input
        id="contact-phone"
        name="電話番号"
        type="tel"
        inputmode="tel"
        required
        maxlength="16"
        autocomplete="tel"
        placeholder="070-8428-0866"
        pattern="0[0-9-]{9,15}"
        title="先頭の0を残した数字とハイフンで入力してください"
        aria-describedby="contact-phone-hint"
        class="mt-1 w-full min-h-12 rounded-lg border border-gray-300 px-3 py-3 text-[16px] text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
      />
      <p id="contact-phone-hint" class="mt-1 text-xs leading-relaxed text-gray-600">
        先頭の0はそのまま残ります。ハイフンあり（070-8428-0866）でも送信できます。
      </p>
      <p id="contact-phone-error" class="mt-1 text-sm font-bold text-cta-red" role="alert"></p>
    </div>

    <div class="mt-4">
      <label for="contact-postal" class="block text-sm font-bold text-gray-900">郵便番号</label>
      <input
        id="contact-postal"
        name="郵便番号"
        type="text"
        inputmode="numeric"
        required
        maxlength="8"
        autocomplete="postal-code"
        placeholder="001-0000"
        pattern="[0-9]{3}-?[0-9]{4}"
        title="先頭の0を残した7桁で入力してください"
        aria-describedby="contact-postal-hint"
        class="mt-1 w-full min-h-12 rounded-lg border border-gray-300 px-3 py-3 text-[16px] text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
      />
      <p id="contact-postal-hint" class="mt-1 text-xs leading-relaxed text-gray-600">
        先頭の0はそのまま残ります。ハイフンあり（001-0000）でも送信できます。
      </p>
      <p id="contact-postal-error" class="mt-1 text-sm font-bold text-cta-red" role="alert"></p>
    </div>

    <div class="mt-4">
      <label for="contact-message" class="block text-sm font-bold text-gray-900">相談内容</label>
      <textarea
        id="contact-message"
        name="相談内容"
        required
        maxlength="2000"
        rows="6"
        placeholder="車種、汚れの場所、希望日など"
        class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-3 text-[16px] leading-relaxed text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
      ></textarea>
      <p id="contact-message-error" class="mt-1 text-sm font-bold text-cta-red" role="alert"></p>
    </div>

    <p id="contact-form-error" class="mt-4 text-sm font-bold text-cta-red" role="alert" hidden></p>

    <button
      id="contact-submit"
      type="submit"
      class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-full bg-gray-900 px-6 py-3 text-base font-bold text-white hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:cursor-not-allowed disabled:opacity-60"
    >
      送信する
    </button>
    <button
      id="contact-native-submit"
      type="submit"
      data-native-submit="true"
      hidden
      class="mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-full border-2 border-gray-900 bg-white px-6 py-3 text-base font-bold text-gray-900 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
    >
      確認画面へ進んで送信
    </button>
  </div>
</form>

<script>
  import { bindContactForm } from '../scripts/contact-form';
  bindContactForm(document);
</script>
