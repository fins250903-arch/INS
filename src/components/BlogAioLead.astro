---
import { TEL_DISPLAY, TEL_HREF } from '../data/site';
import { resolveStoreLpPath } from '../data/region-lp-links';

interface Props {
  answer: string;
  bullets: string[];
  regionFull: string;
  regionSlug: string;
}

const { answer, bullets, regionFull, regionSlug } = Astro.props;
const storePath = resolveStoreLpPath(regionSlug) || resolveStoreLpPath(regionFull) || '/osaka/';
---

<section class="aio-answer mt-6 rounded-2xl border border-amber-200 bg-amber-50/80 p-5 sm:p-6" aria-labelledby="aio-answer-heading">
  <h2 id="aio-answer-heading" class="text-lg font-bold text-gray-900 sm:text-xl">結論（先に読む）</h2>
  <p class="mt-3 text-base font-semibold leading-relaxed text-gray-900">{answer}</p>
  {
    bullets.length > 0 && (
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-gray-800">
        {bullets.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
  <div class="mt-5 grid gap-2 sm:grid-cols-3">
    <a
      href={TEL_HREF}
      class="inline-flex items-center justify-center rounded-full bg-cta-red px-4 py-3 text-sm font-bold text-white hover:opacity-90"
    >
      電話 {TEL_DISPLAY}
    </a>
    <a
      href="/contact/"
      class="inline-flex items-center justify-center rounded-full border-2 border-primary bg-white px-4 py-3 text-sm font-bold text-primary hover:bg-primary hover:text-white"
    >
      メールで問い合わせ
    </a>
    <a
      href={`${storePath}#heading-pricing`}
      class="inline-flex items-center justify-center rounded-full border-2 border-gray-300 bg-white px-4 py-3 text-sm font-bold text-gray-800 hover:border-primary hover:text-primary"
    >
      {regionFull}の料金表
    </a>
  </div>
  <p class="mt-3 text-xs text-gray-600">365日24時間受付・見積無料・立会不要・駐車場完結</p>
</section>
